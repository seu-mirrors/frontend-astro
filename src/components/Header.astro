---
const location = Astro.url.pathname;
import MoonIcon from "astro-heroicons/outline/Moon.astro";
import SunIcon from "astro-heroicons/outline/Sun.astro";
import ComputerIcon from "astro-heroicons/outline/ComputerDesktop.astro";
---

<header
  class="relative flex flex-wrap w-full items-center justify-between bg-white dark:bg-gray-800 text-neutral-900 dark:text-gray-100 caddy-shadow px-caddy py-6 grow-0 shrink-0">
  <div class="caddy-wrapper">
    <div
      class="flex flex-wrap items-center basis-full justify-between font-medium">
      <a class="flex items-center no-underline hover:no-underline" href="/">
        <img
          class="mr-2 h-8 w-8 opacity-95 invert-0 dark:invert"
          src="/favicon.svg"
          alt="SEU Logo"
        />
        <span class="text-xl"
          >东南大学开源镜像站 <span class="text-neutral-400 dark:text-neutral-500">/</span> SEU Mirrors<sup
            class="text-[#587b37] dark:text-[#7ab149] ml-0.5">β</sup
          ></span
        >
      </a>

      <div class="space-x-4 header-nav max-sm:mt-6">
        <a class:list={["rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700", { active: location === "/" }]} href="/"
          >首页</a
        >
        <a
        class:list={["rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700", { active: location.startsWith("/news") }]}
        href="/news/">新闻公告</a
      >
        <a
          class:list={["rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700", { active: location.startsWith("/status") }]}
          href="/status">同步状态</a
        >
        
        <!-- 主题切换按钮 -->
        <button 
          id="theme-toggle" 
          aria-label="切换主题模式" 
          title="切换主题模式"
          class="p-2 translate-y-1 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none transition-colors duration-200 focus:ring-2 focus:ring-gray-300 dark:focus:ring-gray-600">
          <ComputerIcon id="theme-icon-system" class="w-5 h-5" />
          <SunIcon id="theme-icon-light" class="w-5 h-5 hidden" />
          <MoonIcon id="theme-icon-dark" class="w-5 h-5 hidden" />
        </button>
      </div>
    </div>

    <div class={location === "/" ? "mt-8 mb-4 space-y-2 basis-full" : "hidden"}>
      <h1 class="font-medium text-black dark:text-white text-4xl">稳定、可靠的开源镜像服务</h1>
      <p class="text-xl dark:text-gray-200">基于「快照」的原子化同步，无中间状态，始终完整。</p>
    </div>
  </div>
</header>

<script>
  declare global {
    interface Window {
      themeManager?: {
        toggleTheme: () => void;
        updateThemeUI: (theme: string) => void;
        getCurrentTheme: () => string;
      };
    }
  }

  // 设置主题切换按钮事件
  function setupThemeToggle() {
    // console.log('设置主题切换按钮事件');
    const toggleButton = document.getElementById('theme-toggle');
    
    if (!toggleButton) return;
    
    if (toggleButton.getAttribute('data-theme-initialized') === 'true') {
      return;
    }
    
    // 标记已初始化
    toggleButton.setAttribute('data-theme-initialized', 'true');
    
    // 添加点击事件
    toggleButton.addEventListener('click', (e) => {
      e.preventDefault(); // 防止事件冒泡
      console.log('主题切换按钮被点击');
      
      // 立即显示视觉反馈
      toggleButton.classList.add('active');
      setTimeout(() => toggleButton.classList.remove('active'), 200);
      
      // 使用主题管理器切换主题
      if (window.themeManager && typeof window.themeManager.toggleTheme === 'function') {
        window.themeManager.toggleTheme();
      } else {
        console.error('主题管理器未初始化或toggleTheme方法不可用');
      }
    });
    
    // 确保图标状态与当前主题匹配
    if (window.themeManager && typeof window.themeManager.updateThemeUI === 'function') {
      const currentTheme = window.themeManager.getCurrentTheme();
      window.themeManager.updateThemeUI(currentTheme);
    }
  }

  // 初始加载时设置
  document.addEventListener('DOMContentLoaded', setupThemeToggle);
  
  // Astro View Transitions支持
  document.addEventListener('astro:page-load', setupThemeToggle);
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
