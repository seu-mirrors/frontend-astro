---
import Layout from "../layouts/Layout.astro";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import MirrorStatus from "../components/MirrorStatus.astro";
import "../styles/app.css";
---

<Layout title="同步状态">
  <Header />
  <div
    class="caddy-wrapper flex flex-wrap bg-white dark:bg-gray-800 text-neutral-900 dark:text-gray-100 gap-0 lg:divide-x max-lg:divide-y dark:divide-gray-700 caddy-main grow">
    <MirrorStatus />
  </div>
  <Footer />
</Layout>
